+static Map* SlambenchLargestMap(Atlas* pAtlas, Map* pExclude = nullptr)
+{
+    // Same choice as SaveTrajectoryEuRoC: first map (atlas order) with the most keyframes.
+    Map* pBiggerMap = nullptr;
+    size_t numMaxKFs = 0;
+    for(Map* pMap : pAtlas->GetAllMaps())
+    {
+        if(pMap == pExclude)
+            continue;
+        if(pMap->GetAllKeyFrames().size() > numMaxKFs)
+        {
+            numMaxKFs = pMap->GetAllKeyFrames().size();
+            pBiggerMap = pMap;
+        }
+    }
+    return pBiggerMap;
+}
+
+bool System::GetLoadedMapInfo(LoadedMapInfo &info)
+{
+    if(!mbLoadedAtlas)
+        return false;
+    Map* pMap = SlambenchLargestMap(mpAtlas);
+    if(!pMap)
+        return false;
+    info.map = pMap;
+    info.map_id = pMap->GetId();
+    KeyFrame* pOrigin = pMap->GetOriginKF();
+    info.origin_kf_id = pOrigin ? pOrigin->mnId : 0;
+    info.n_keyframes = pMap->KeyFramesInMap();
+    info.n_map_points = pMap->MapPointsInMap();
+    info.n_maps = 0;
+    info.n_keyframes_atlas = 0;
+    info.n_map_points_atlas = 0;
+    for(Map* pMi : mpAtlas->GetAllMaps())
+    {
+        if(pMi->KeyFramesInMap() == 0)
+            continue;
+        ++info.n_maps;
+        info.n_keyframes_atlas += pMi->KeyFramesInMap();
+        info.n_map_points_atlas += pMi->MapPointsInMap();
+    }
+    vector<KeyFrame*> vpKFs = pMap->GetAllKeyFrames();
+    sort(vpKFs.begin(), vpKFs.end(), KeyFrame::lId);
+    Sophus::SE3f Twb;
+    if (mSensor==IMU_MONOCULAR || mSensor==IMU_STEREO || mSensor==IMU_RGBD)
+        Twb = vpKFs[0]->GetImuPose();
+    else
+        Twb = vpKFs[0]->GetPoseInverse();
+    info.T_final_map = Twb.inverse();
+    return true;
+}
+
+bool System::StartRelocalizationInLoadedMap()
+{
+    if(!mbLoadedAtlas)
+        return false;
+    Map* pEmpty = mpAtlas->GetCurrentMap();  // created by the constructor after loading
+    Map* pMap = SlambenchLargestMap(mpAtlas, pEmpty);
+    if(!pMap)
+        return false;
+    mpAtlas->ChangeMap(pMap);
+    if(pEmpty && pEmpty != pMap && pEmpty->KeyFramesInMap() == 0)
+    {
+        mpAtlas->SetMapBad(pEmpty);
+        mpAtlas->RemoveBadMaps();
+    }
+    mpTracker->SetRelocalizeOnly(true);
+    ActivateLocalizationMode();
+    return true;
+}
+
+bool System::RelocalizedThisFrame()
+{
+    return mpTracker->RelocalizedThisFrame();
+}
+
+bool System::TrackingVisualOdometryOnly()
+{
+    return mpTracker->mbOnlyTracking && mpTracker->VisualOdometryOnly();
+}
