+System::MapFrameInfo System::GetCurrentMapFrameInfo()
+{
+    MapFrameInfo info;
+    Map* pMap = mpAtlas->GetCurrentMap();
+    if(!pMap)
+        return info;
+    info.map = pMap;
+    info.map_id = pMap->GetId();
+    // mpKFinitial is only assigned once the map has a keyframe (never freed afterwards).
+    if(pMap->KeyFramesInMap() > 0)
+    {
+        KeyFrame* pKF = pMap->GetOriginKF();
+        if(pKF)
+        {
+            const Sophus::SE3f Twc = pKF->GetPoseInverse();
+            info.has_origin = true;
+            info.origin_kf_id = pKF->mnId;
+            info.t_w_origin = Twc.translation();
+            info.q_w_origin = Twc.unit_quaternion();
+        }
+    }
+    return info;
+}
