+void LoopClosing::SetPlaceRecognitionLog(const std::string &path)
+{
+    unique_lock<mutex> lock(mMutexPRLog);
+    delete mpPRLog;
+    mpPRLog = new std::ofstream(path);
+    *mpPRLog << "kf_time_s,kf_id,map_id,map_kfs,kind,event,cand_kf_id,cand_map_id,n_candidates,bow_matches,"
+                "sim3_inliers,proj_matches,opt_matches,proj_opt_matches,covisible_consistent,coincidences\n";
+    mpPRLog->flush();
+}
+
+// One row per place-recognition check of the current keyframe. kind: loop | merge | "" (both).
+// Thresholds (DetectCommonRegionsFromBoW): bow_matches >= 20, sim3 RANSAC converged with >= 15
+// inliers, proj_matches >= 50, opt_matches >= 20, proj_opt_matches >= 80, covisible_consistent >= 3
+// for an immediate detection; otherwise 3 consecutive keyframes (coincidences) are needed via
+// refine_* (DetectAndReffineSim3FromLastKF: proj >= 30, opt > 50, proj_opt >= 100).
+void LoopClosing::PRLog(const char* event, KeyFrame* pCand, int nCand, int bow, int sim3, int proj, int opt,
+                        int projOpt, int cov, int coinc)
+{
+    unique_lock<mutex> lock(mMutexPRLog);
+    if(!mpPRLog || !mpCurrentKF)
+        return;
+    Map* pMap = mpCurrentKF->GetMap();
+    *mpPRLog << std::fixed << std::setprecision(6) << mpCurrentKF->mTimeStamp << "," << mpCurrentKF->mnId << ","
+             << (pMap ? (long)pMap->GetId() : -1L) << "," << (pMap ? (long)pMap->KeyFramesInMap() : -1L) << ","
+             << mPRKind << "," << event << ",";
+    if(pCand)
+        *mpPRLog << pCand->mnId << "," << (pCand->GetMap() ? (long)pCand->GetMap()->GetId() : -1L);
+    else
+        *mpPRLog << ",";
+    *mpPRLog << "," << nCand << "," << bow << "," << sim3 << "," << proj << "," << opt << "," << projOpt << ","
+             << cov << "," << coinc << "\n";
+    mpPRLog->flush();
+}
