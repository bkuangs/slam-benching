+// LightGlue input descriptors of a map keyframe: unit-norm (SuperPoint.unitDescriptors) or recovered
+// from the per-channel-normalized ones (cached).
+cv::Mat Tracking::SlambenchLightGlueDescriptors(KeyFrame* pKF)
+{
+    if(SPDetector::unitDescriptors || !mbLearnedRelocRecoverDesc)
+        return pKF->mDescriptors;
+    auto it = mLearnedRelocKFDesc.find(pKF);
+    if(it == mLearnedRelocKFDesc.end())
+        it = mLearnedRelocKFDesc.emplace(pKF, SlambenchUnitNormDescriptors(pKF->mDescriptors)).first;
+    return it->second;
+}
+
+// slam-benching patch (map anchoring), see Tracking.h.
+bool Tracking::MapAnchor()
+{
+    typedef std::chrono::steady_clock clk;
+    auto ms = [](clk::time_point a, clk::time_point b) { return std::chrono::duration<double, std::milli>(b - a).count(); };
+    const clk::time_point t0 = clk::now();
+    auto pLG = SPmatcher::GetLightGlue();
+    Map* pMap = mpAtlas->GetCurrentMap();
+    if(!pLG || !pLG->isLoaded() || !pMap || mCurrentFrame.mTcw.empty() || mCurrentFrame.mDescriptors.empty())
+        return false;
+
+    // Saved VO solution, restored when the anchor is rejected.
+    const cv::Mat TcwVO = mCurrentFrame.mTcw.clone();
+    const vector<MapPoint*> vpMPsVO = mCurrentFrame.mvpMapPoints;
+    const vector<bool> vbOutVO = mCurrentFrame.mvbOutlier;
+
+    // 1. Nearest map keyframes to the VO pose with similar viewing direction.
+    cv::Mat Rwc = TcwVO.rowRange(0,3).colRange(0,3).t();
+    cv::Mat Ow = -Rwc*TcwVO.rowRange(0,3).col(3);
+    cv::Mat zw = Rwc.col(2);
+    const float cosMax = std::cos(mfMapAnchorMaxKFAngleDeg * CV_PI / 180.0);
+    vector<pair<float,KeyFrame*> > vDistKF;
+    for(KeyFrame* pKF : pMap->GetAllKeyFrames())
+    {
+        if(!pKF || pKF->isBad() || pKF->mDescriptors.empty())
+            continue;
+        cv::Mat Tkw = pKF->GetPose();
+        cv::Mat Rkw = Tkw.rowRange(0,3).colRange(0,3);
+        const float d = cv::norm(pKF->GetCameraCenter() - Ow);
+        const float c = Rkw.row(2).dot(zw.t());
+        if(d <= mfMapAnchorMaxKFDist && c >= cosMax)
+            vDistKF.push_back(make_pair(d, pKF));
+    }
+    sort(vDistKF.begin(), vDistKF.end(), [](const pair<float,KeyFrame*> &a, const pair<float,KeyFrame*> &b) { return a.first < b.first; });
+    if((int)vDistKF.size() > mnMapAnchorK)
+        vDistKF.resize(mnMapAnchorK);
+
+    // 2. LightGlue matches to their map points (union, first keyframe wins).
+    const cv::Size imgSize(mCurrentFrame.mnMaxX - mCurrentFrame.mnMinX, mCurrentFrame.mnMaxY - mCurrentFrame.mnMinY);
+    cv::Mat queryDesc = (SPDetector::unitDescriptors || !mbLearnedRelocRecoverDesc)
+                        ? mCurrentFrame.mDescriptors : SlambenchUnitNormDescriptors(mCurrentFrame.mDescriptors);
+    vector<MapPoint*> vpMatches(mCurrentFrame.N, static_cast<MapPoint*>(NULL));
+    int nRaw = 0, nMP = 0;
+    std::ostringstream kfIds;
+    for(size_t k = 0; k < vDistKF.size(); k++)
+    {
+        KeyFrame* pKF = vDistKF[k].second;
+        kfIds << (k ? ";" : "") << pKF->mnId;
+        std::vector<LightGlueMatch> lgMatches;
+        try {
+            lgMatches = pLG->match(pKF->mvKeysUn, SlambenchLightGlueDescriptors(pKF), mCurrentFrame.mvKeysUn, queryDesc, imgSize);
+        } catch (...) {
+            lgMatches.clear();
+        }
+        nRaw += lgMatches.size();
+        const vector<MapPoint*> vpKFMPs = pKF->GetMapPointMatches();
+        for(const LightGlueMatch &m : lgMatches)
+        {
+            if(m.idx0 < 0 || m.idx0 >= (int)vpKFMPs.size() || m.idx1 < 0 || m.idx1 >= mCurrentFrame.N)
+                continue;
+            MapPoint* pMP = vpKFMPs[m.idx0];
+            if(pMP && !pMP->isBad() && !vpMatches[m.idx1])
+            {
+                vpMatches[m.idx1] = pMP;
+                nMP++;
+            }
+        }
+    }
+    // Keep the motion-model map-point matches where LightGlue found none.
+    for(int i = 0; i < mCurrentFrame.N; i++)
+        if(!vpMatches[i] && vpMPsVO[i] && !vbOutVO[i] && vpMPsVO[i]->Observations() > 0)
+            vpMatches[i] = vpMPsVO[i];
+
+    // 3. Pose on the map points (MLPnP RANSAC, so a drifted VO pose is no obstacle; the VO pose as the
+    //    initial guess when RANSAC finds nothing), then the local map.
+    int nGood = 0, nLocal = 0;
+    float dDist = -1.f, dAng = -1.f;
+    bool bOK = false;
+    if(nMP >= 10)
+    {
+        mCurrentFrame.mvpMapPoints = vpMatches;
+        fill(mCurrentFrame.mvbOutlier.begin(), mCurrentFrame.mvbOutlier.end(), false);
+        int nMatched = 0;
+        for(int i = 0; i < mCurrentFrame.N; i++)
+            if(vpMatches[i])
+                nMatched++;
+        if(nMatched >= 15)
+        {
+            MLPnPsolver solver(mCurrentFrame, vpMatches);
+            solver.SetRansacParameters(0.99,10,mnLearnedRelocRansacMaxIter,6,mfLearnedRelocRansacEpsilon,5.991);
+            bool bNoMore = false;
+            vector<bool> vbInliers;
+            int nInliers = 0;
+            cv::Mat Tcw;
+            while(Tcw.empty() && !bNoMore)
+                Tcw = solver.iterate(5,bNoMore,vbInliers,nInliers);
+            if(!Tcw.empty())
+            {
+                Tcw.copyTo(mCurrentFrame.mTcw);
+                for(size_t j = 0; j < vbInliers.size() && j < (size_t)mCurrentFrame.N; j++)
+                    if(!vbInliers[j])
+                        mCurrentFrame.mvpMapPoints[j] = static_cast<MapPoint*>(NULL);
+            }
+            else
+                mCurrentFrame.SetPose(TcwVO);
+        }
+        nGood = Optimizer::PoseOptimization(&mCurrentFrame);
+        if(nGood >= 10)
+        {
+            for(int i = 0; i < mCurrentFrame.N; i++)
+                if(mCurrentFrame.mvbOutlier[i])
+                {
+                    mCurrentFrame.mvpMapPoints[i] = static_cast<MapPoint*>(NULL);
+                    mCurrentFrame.mvbOutlier[i] = false;
+                }
+            const bool bLocalOK = TrackLocalMap();
+            nLocal = mnMatchesInliers;
+            SlambenchPoseDiff(TcwVO, mCurrentFrame.mTcw, dDist, dAng);
+            bOK = bLocalOK && nLocal >= mnMapAnchorMinInliers
+                  && dDist <= mfMapAnchorMaxCorrection && dAng <= mfMapAnchorMaxCorrectionDeg;
+        }
+    }
+    if(!bOK)
+    {
+        mCurrentFrame.SetPose(TcwVO);
+        mCurrentFrame.mvpMapPoints = vpMPsVO;
+        mCurrentFrame.mvbOutlier = vbOutVO;
+    }
+    if(mMapAnchorLog.is_open())
+    {
+        mMapAnchorLog << std::fixed << std::setprecision(9) << mCurrentFrame.mTimeStamp << "," << mCurrentFrame.mnId << ","
+            << kfIds.str() << "," << nRaw << "," << nMP << "," << nGood << "," << nLocal << ","
+            << std::setprecision(4) << dDist << "," << dAng << "," << (bOK ? 1 : 0) << ","
+            << std::setprecision(1) << ms(t0, clk::now()) << "\n";
+        mMapAnchorLog.flush();
+    }
+    return bOK;
+}
+
