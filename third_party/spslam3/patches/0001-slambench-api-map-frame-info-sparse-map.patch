+System::MapFrameInfo System::GetCurrentMapFrameInfo()
+{
+    MapFrameInfo info;
+    Map* pMap = mpAtlas->GetCurrentMap();
+    if(!pMap)
+        return info;
+    info.map = pMap;
+    info.map_id = pMap->GetId();
+    info.n_keyframes = pMap->KeyFramesInMap();
+    info.n_map_points = pMap->MapPointsInMap();
+    if(info.n_keyframes > 0)
+    {
+        KeyFrame* pKF = pMap->GetOriginKF();
+        if(pKF)
+        {
+            const cv::Mat Twc = pKF->GetPoseInverse();
+            const vector<float> q = Converter::toQuaternion(Twc.rowRange(0,3).colRange(0,3));
+            info.has_origin = true;
+            info.origin_kf_id = pKF->mnId;
+            for(int i=0; i<3; i++)
+                info.t_w_origin[i] = Twc.at<float>(i,3);
+            for(int i=0; i<4; i++)
+                info.q_w_origin[i] = q[i];
+        }
+    }
+    return info;
+}
+
+std::vector<unsigned char> System::GetTrackedOutlierFlags()
+{
+    // Tracking runs in the caller's thread, so mCurrentFrame is the frame just tracked.
+    const std::vector<bool> &out = mpTracker->mCurrentFrame.mvbOutlier;
+    return std::vector<unsigned char>(out.begin(), out.end());
+}
+
+bool System::SaveSparseMapSlambench(const std::string &dir)
+{
+    vector<Map*> vpMaps = mpAtlas->GetAllMaps();
+    // Same map choice and world reference as SaveTrajectoryEuRoC (first map with the most keyframes).
+    Map* pBiggerMap = nullptr;
+    size_t numMaxKFs = 0;
+    for(Map* pMap : vpMaps)
+    {
+        if(pMap->GetAllKeyFrames().size() > numMaxKFs)
+        {
+            numMaxKFs = pMap->GetAllKeyFrames().size();
+            pBiggerMap = pMap;
+        }
+    }
+    cv::Mat Tfw = cv::Mat::eye(4,4,CV_32F);  // final-trajectory world <- map world
+    if(pBiggerMap)
+    {
+        vector<KeyFrame*> vpKFs = pBiggerMap->GetAllKeyFrames();
+        sort(vpKFs.begin(), vpKFs.end(), KeyFrame::lId);
+        cv::Mat Twb;
+        if (mSensor==IMU_MONOCULAR || mSensor==IMU_STEREO)
+            Twb = vpKFs[0]->GetImuPose();
+        else
+            Twb = vpKFs[0]->GetPoseInverse();
+        Tfw = Twb.inv();
+    }
+    ofstream fp((dir + "/map_points.csv").c_str());
+    ofstream fk((dir + "/keyframes.csv").c_str());
+    if(!fp.is_open() || !fk.is_open())
+        return false;
+    fp << "map_id,point_id,x,y,z,n_observations,in_final_frame\n" << fixed << setprecision(6);
+    fk << "map_id,keyframe_id,timestamp_ns,tx,ty,tz,qx,qy,qz,qw,in_final_frame\n" << fixed;
+    const cv::Mat I = cv::Mat::eye(4,4,CV_32F);
+    for(Map* pMap : vpMaps)
+    {
+        const bool inFinal = (pMap == pBiggerMap);
+        const cv::Mat T = inFinal ? Tfw : I;
+        const cv::Mat R = T.rowRange(0,3).colRange(0,3), t = T.rowRange(0,3).col(3);
+        for(MapPoint* pMP : pMap->GetAllMapPoints())
+        {
+            if(!pMP || pMP->isBad())
+                continue;
+            const cv::Mat p = R * pMP->GetWorldPos() + t;
+            fp << pMap->GetId() << "," << pMP->mnId << "," << p.at<float>(0) << "," << p.at<float>(1) << ","
+               << p.at<float>(2) << "," << pMP->Observations() << "," << (inFinal ? 1 : 0) << "\n";
+        }
+        for(KeyFrame* pKF : pMap->GetAllKeyFrames())
+        {
+            if(!pKF || pKF->isBad())
+                continue;
+            const cv::Mat Twc = T * pKF->GetPoseInverse();
+            const vector<float> q = Converter::toQuaternion(Twc.rowRange(0,3).colRange(0,3));
+            fk << pMap->GetId() << "," << pKF->mnId << "," << setprecision(0) << 1e9 * pKF->mTimeStamp << ","
+               << setprecision(9) << Twc.at<float>(0,3) << "," << Twc.at<float>(1,3) << "," << Twc.at<float>(2,3)
+               << "," << q[0] << "," << q[1] << "," << q[2] << "," << q[3] << "," << (inFinal ? 1 : 0) << "\n";
+        }
+    }
+    return true;
+}
