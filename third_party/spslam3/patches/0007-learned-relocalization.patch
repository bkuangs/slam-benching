+torch::Tensor PlaceRecognition::extractDescriptorRaw(const cv::Mat &image, bool rgb)
+{
+    if (!mbLoaded || image.empty())
+        return torch::Tensor();
+
+    cv::Mat img;  // RGB uint8, as the offline benchmark (cv2.imread(IMREAD_COLOR)[..., ::-1])
+    if (image.channels() == 1)
+        cv::cvtColor(image, img, cv::COLOR_GRAY2RGB);
+    else if (image.channels() == 3)
+    {
+        if (rgb)
+            img = image.clone();
+        else
+            cv::cvtColor(image, img, cv::COLOR_BGR2RGB);
+    }
+    else
+        cv::cvtColor(image, img, rgb ? cv::COLOR_RGBA2RGB : cv::COLOR_BGRA2RGB);
+    if (!img.isContinuous())
+        img = img.clone();
+
+    std::lock_guard<std::mutex> lock(LightGlue::getInferenceMutex());
+    torch::NoGradGuard no_grad;
+    auto input = torch::from_blob(img.data, {1, img.rows, img.cols, 3}, torch::kUInt8).to(mDevice);
+    auto output = mModel.forward({input}).toTensor().to(torch::kFloat32).squeeze(0);
+    output = output / output.norm();
+    auto result = output.to(torch::kCPU).contiguous();
+    if (mDevice.is_cuda())
+        torch::cuda::synchronize();
+    return result;
+}
+
+void PlaceRecognition::warmUp(int width, int height)
+{
+    cv::Mat dummy(height, width, CV_8UC3, cv::Scalar(64, 128, 192));
+    for (int i = 0; i < 3; i++)
+        extractDescriptorRaw(dummy, false);
+}
