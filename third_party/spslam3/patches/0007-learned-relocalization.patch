+static void SlambenchPoseDiff(const cv::Mat &Tcw1, const cv::Mat &Tcw2, float &dist, float &angleDeg)
+{
+    cv::Mat R1 = Tcw1.rowRange(0,3).colRange(0,3), R2 = Tcw2.rowRange(0,3).colRange(0,3);
+    cv::Mat O1 = -R1.t()*Tcw1.rowRange(0,3).col(3), O2 = -R2.t()*Tcw2.rowRange(0,3).col(3);
+    dist = cv::norm(O1 - O2);
+    cv::Mat dR = R1*R2.t();
+    double c = (cv::trace(dR)[0] - 1.0) / 2.0;
+    c = std::max(-1.0, std::min(1.0, c));
+    angleDeg = std::acos(c) * 180.0 / CV_PI;
+}
+
+// Upstream SPDetector::computeDescriptors divides every descriptor channel by its norm over all
+// keypoints of the image (torch::norm(desc, 2, 1) on a [256, N] tensor) instead of every descriptor by
+// its own norm. SP_SLAM3 descriptors therefore carry an image-dependent per-channel scale (|d| ~ 0.46),
+// which LightGlue tolerates for the same lighting but not across lighting (~0 matches). The scales are
+// recovered by requiring unit-norm rows, i.e. least squares for w_c = s_c^2 in sum_c w_c b_kc^2 = 1,
+// then rows are re-normalized (with fewer keypoints than channels only the row normalization is done).
+static cv::Mat SlambenchUnitNormDescriptors(const cv::Mat &desc)
+{
+    cv::Mat b;
+    desc.convertTo(b, CV_64F);
+    const int n = b.rows, d = b.cols;
+    cv::Mat out;
+    if(n >= d && d > 0)
+    {
+        cv::Mat A = b.mul(b), G, r, w;
+        cv::mulTransposed(A, G, true);
+        cv::reduce(A, r, 0, cv::REDUCE_SUM);
+        r = r.t();
+        G += cv::Mat::eye(d, d, CV_64F) * (1e-9 * cv::trace(G)[0] / d + 1e-12);
+        if(cv::solve(G, r, w, cv::DECOMP_CHOLESKY))
+        {
+            cv::Mat sc(1, d, CV_64F);
+            for(int c = 0; c < d; c++)
+                sc.at<double>(0, c) = std::sqrt(std::max(0.0, w.at<double>(c)));
+            out = b.mul(cv::repeat(sc, n, 1));
+        }
+    }
+    if(out.empty())
+        out = b.clone();
+    for(int k = 0; k < n; k++)
+    {
+        cv::Mat row = out.row(k);
+        const double nr = cv::norm(row);
+        if(nr > 1e-12)
+            row /= nr;
+    }
+    out.convertTo(out, CV_32F);
+    return out;
+}
+
+bool Tracking::LearnedRelocalization()
+{
+    typedef std::chrono::steady_clock clk;
+    auto ms = [](clk::time_point a, clk::time_point b) {
+        return std::chrono::duration<double, std::milli>(b - a).count(); };
+    const clk::time_point t0 = clk::now();
+    const bool bFromVO = !(mState==LOST || mState==RECENTLY_LOST);
+
+    // 1. Query descriptor of the current (left) image.
+    torch::Tensor q = mpGlobalDescExtractor->extractDescriptorRaw(
+        mImLeftInput.empty() ? mImGray : mImLeftInput, mbRGB);
+    const clk::time_point t1 = clk::now();
+
+    // 2. Top-K keyframes of the current map by cosine similarity (brute force).
+    Map* pMap = mpAtlas->GetCurrentMap();
+    const vector<KeyFrame*> vpAllKFs = pMap->GetAllKeyFrames();
+    if(pMap != mpGlobalDescMap || vpAllKFs.size() != mnGlobalDescMapKFs)
+    {
+        mvpGlobalDescKFs.clear();
+        vector<torch::Tensor> vDescs;
+        for(KeyFrame* pKF : vpAllKFs)
+        {
+            if(pKF->isBad() || !pKF->mGlobalDescriptor.defined() || !q.defined()
+               || pKF->mGlobalDescriptor.numel() != q.numel())
+                continue;
+            mvpGlobalDescKFs.push_back(pKF);
+            vDescs.push_back(pKF->mGlobalDescriptor.view({-1}));
+        }
+        mGlobalDescMatrix = vDescs.empty() ? torch::Tensor() : torch::stack(vDescs).contiguous();
+        mpGlobalDescMap = pMap;
+        mnGlobalDescMapKFs = vpAllKFs.size();
+    }
+    vector<KeyFrame*> vpCandidateKFs;
+    vector<float> vSims;
+    if(q.defined() && mGlobalDescMatrix.defined())
+    {
+        torch::Tensor sims = torch::mv(mGlobalDescMatrix, q);
+        const int k = std::min<int>(mnLearnedRelocTopK, mvpGlobalDescKFs.size());
+        auto top = sims.topk(k);
+        torch::Tensor vals = std::get<0>(top).contiguous(), idx = std::get<1>(top).contiguous();
+        for(int i = 0; i < k; i++)
+        {
+            KeyFrame* pKF = mvpGlobalDescKFs[idx[i].item<int64_t>()];
+            if(pKF->isBad())
+                continue;
+            vpCandidateKFs.push_back(pKF);
+            vSims.push_back(vals[i].item<float>());
+        }
+    }
+    const clk::time_point t2 = clk::now();
+
+    // 3. Verification of every candidate; the one with the most final inliers is kept.
+    const int nKFs = vpCandidateKFs.size();
+    vector<int> vnRaw(nKFs, 0), vnMP(nKFs, 0), vnPnP(nKFs, 0), vnGood(nKFs, 0);
+    vector<double> vVerifyMs(nKFs, 0.0);
+    int bestIdx = -1, bestGood = -1;
+    cv::Mat bestTcw;
+    vector<MapPoint*> vpBestMPs;
+    vector<bool> vbBestOutlier;
+
+    auto pLG = SPmatcher::GetLightGlue();
+    const cv::Size imgSize(mCurrentFrame.mnMaxX - mCurrentFrame.mnMinX, mCurrentFrame.mnMaxY - mCurrentFrame.mnMinY);
+    if(mbLearnedRelocVerifierBoW && nKFs > 0)
+        mCurrentFrame.ComputeBoW();
+    ORBmatcher matcherBoW(0.75,true);
+    ORBmatcher matcher2(0.8,true);
+    const int minInl = mnLearnedRelocMinInliers;
+    cv::Mat queryDesc;
+
+    for(int i = 0; i < nKFs; i++)
+    {
+        const clk::time_point tv0 = clk::now();
+        KeyFrame* pKF = vpCandidateKFs[i];
+        vector<MapPoint*> vpMatches(mCurrentFrame.N, static_cast<MapPoint*>(NULL));
+        if(mbLearnedRelocVerifierBoW)
+        {
+            vnMP[i] = matcherBoW.SearchByBoW(pKF, mCurrentFrame, vpMatches);
+            vnRaw[i] = -1;
+        }
+        else if(pLG && pLG->isLoaded() && !pKF->mDescriptors.empty() && !mCurrentFrame.mDescriptors.empty())
+        {
+            std::vector<LightGlueMatch> lgMatches;
+            try {
+                if(mbLearnedRelocRecoverDesc)
+            {
+                if(queryDesc.empty())
+                    queryDesc = SlambenchUnitNormDescriptors(mCurrentFrame.mDescriptors);
+                auto it = mLearnedRelocKFDesc.find(pKF);
+                if(it == mLearnedRelocKFDesc.end())
+                    it = mLearnedRelocKFDesc.emplace(pKF, SlambenchUnitNormDescriptors(pKF->mDescriptors)).first;
+                lgMatches = pLG->match(pKF->mvKeysUn, it->second, mCurrentFrame.mvKeysUn, queryDesc, imgSize);
+            }
+            else
+                lgMatches = pLG->match(pKF->mvKeysUn, pKF->mDescriptors,
+                                       mCurrentFrame.mvKeysUn, mCurrentFrame.mDescriptors, imgSize);
+            } catch (...) {
+                lgMatches.clear();
+            }
+            vnRaw[i] = lgMatches.size();
+            const vector<MapPoint*> vpKFMPs = pKF->GetMapPointMatches();
+            for(const LightGlueMatch &m : lgMatches)
+            {
+                if(m.idx0 < 0 || m.idx0 >= (int)vpKFMPs.size() || m.idx1 < 0 || m.idx1 >= mCurrentFrame.N)
+                    continue;
+                MapPoint* pMP = vpKFMPs[m.idx0];
+                if(pMP && !pMP->isBad() && !vpMatches[m.idx1])
+                {
+                    vpMatches[m.idx1] = pMP;
+                    vnMP[i]++;
+                }
+            }
+        }
+        if(vnMP[i] >= 15)
+        {
+            MLPnPsolver solver(mCurrentFrame, vpMatches);
+            // Stock relocalization: (0.99,10,300,6,0.5,5.991), i.e. a pose needs >= 50% of the
+            // matches as inliers; cross-lighting matches have lower inlier ratios, so the expected
+            // inlier ratio and iteration budget are settings (the >= minInliers gate is unchanged).
+            solver.SetRansacParameters(0.99,10,mnLearnedRelocRansacMaxIter,6,mfLearnedRelocRansacEpsilon,5.991);
+            bool bNoMore = false;
+            vector<bool> vbInliers;
+            int nInliers = 0;
+            cv::Mat Tcw;
+            while(Tcw.empty() && !bNoMore)
+                Tcw = solver.iterate(5,bNoMore,vbInliers,nInliers);
+            if(!Tcw.empty())
+            {
+                vnPnP[i] = nInliers;
+                Tcw.copyTo(mCurrentFrame.mTcw);
+                set<MapPoint*> sFound;
+                for(size_t j = 0; j < vbInliers.size(); j++)
+                {
+                    if(vbInliers[j])
+                    {
+                        mCurrentFrame.mvpMapPoints[j] = vpMatches[j];
+                        sFound.insert(vpMatches[j]);
+                    }
+                    else
+                        mCurrentFrame.mvpMapPoints[j] = NULL;
+                }
+                int nGood = Optimizer::PoseOptimization(&mCurrentFrame);
+                if(nGood >= 10)
+                {
+                    for(int io = 0; io < mCurrentFrame.N; io++)
+                        if(mCurrentFrame.mvbOutlier[io])
+                            mCurrentFrame.mvpMapPoints[io] = static_cast<MapPoint*>(NULL);
+                    // Same refinement as Relocalization(), with the configured inlier threshold.
+                    if(nGood < minInl)
+                    {
+                        int nadditional = matcher2.SearchByProjection(mCurrentFrame,pKF,sFound,10,ORBmatcher::TH_HIGH);
+                        if(nadditional+nGood >= minInl)
+                        {
+                            nGood = Optimizer::PoseOptimization(&mCurrentFrame);
+                            if(nGood > 30 && nGood < minInl)
+                            {
+                                sFound.clear();
+                                for(int ip = 0; ip < mCurrentFrame.N; ip++)
+                                    if(mCurrentFrame.mvpMapPoints[ip])
+                                        sFound.insert(mCurrentFrame.mvpMapPoints[ip]);
+                                nadditional = matcher2.SearchByProjection(mCurrentFrame,pKF,sFound,3,ORBmatcher::TH_LOW+0.28f*(ORBmatcher::TH_HIGH-ORBmatcher::TH_LOW));
+                                if(nGood+nadditional >= minInl)
+                                {
+                                    nGood = Optimizer::PoseOptimization(&mCurrentFrame);
+                                    for(int io = 0; io < mCurrentFrame.N; io++)
+                                        if(mCurrentFrame.mvbOutlier[io])
+                                            mCurrentFrame.mvpMapPoints[io] = NULL;
+                                }
+                            }
+                        }
+                    }
+                }
+                vnGood[i] = nGood;
+                if(nGood >= 10 && nGood > bestGood)
+                {
+                    bestGood = nGood;
+                    bestIdx = i;
+                    bestTcw = mCurrentFrame.mTcw.clone();
+                    vpBestMPs = mCurrentFrame.mvpMapPoints;
+                    vbBestOutlier = mCurrentFrame.mvbOutlier;
+                }
+            }
+        }
+        vVerifyMs[i] = ms(tv0, clk::now());
+    }
+    const clk::time_point t3 = clk::now();
+
+    // 4. Inlier gate and temporal consistency.
+    const bool bAccepted = bestIdx >= 0 && bestGood >= minInl;
+    float dDist = -1.f, dAng = -1.f;
+    if(bAccepted)
+    {
+        if(mnRelocPendingCount > 0 && mCurrentFrame.mnId == mnRelocPendingFrameId + 1)
+        {
+            SlambenchPoseDiff(mRelocPendingTcw, bestTcw, dDist, dAng);
+            if(dDist <= mfLearnedRelocMaxDist && dAng <= mfLearnedRelocMaxAngleDeg)
+                mnRelocPendingCount++;
+            else
+                mnRelocPendingCount = 1;
+        }
+        else
+            mnRelocPendingCount = 1;
+        mnRelocPendingFrameId = mCurrentFrame.mnId;
+        mRelocPendingTcw = bestTcw.clone();
+    }
+    else
+        mnRelocPendingCount = 0;
+    const bool bConfirmed = bAccepted && mnRelocPendingCount >= mnLearnedRelocConsistentFrames;
+
+    if(bConfirmed)
+    {
+        mCurrentFrame.SetPose(bestTcw);
+        mCurrentFrame.mvpMapPoints = vpBestMPs;
+        mCurrentFrame.mvbOutlier = vbBestOutlier;
+    }
+    else
+        fill(mCurrentFrame.mvpMapPoints.begin(), mCurrentFrame.mvpMapPoints.end(), static_cast<MapPoint*>(NULL));
+
+    if(mLearnedRelocLog.is_open())
+    {
+        auto join = [](const auto &v, auto f) {
+            std::ostringstream o;
+            for(size_t i = 0; i < v.size(); i++) o << (i ? ";" : "") << f(v[i]);
+            return o.str(); };
+        mLearnedRelocLog << std::fixed << std::setprecision(9) << mCurrentFrame.mTimeStamp << ","
+            << mCurrentFrame.mnId << "," << (bFromVO ? "vo" : "lost") << "," << mvpGlobalDescKFs.size() << ","
+            << std::setprecision(3) << ms(t0, t1) << "," << ms(t1, t2) << "," << ms(t2, t3) << "," << ms(t0, t3) << ","
+            << join(vpCandidateKFs, [](KeyFrame* k) { return k->mnId; }) << ","
+            << std::setprecision(5) << join(vSims, [](float x) { return x; }) << ","
+            << join(vnRaw, [](int x) { return x; }) << "," << join(vnMP, [](int x) { return x; }) << ","
+            << join(vnPnP, [](int x) { return x; }) << "," << join(vnGood, [](int x) { return x; }) << ","
+            << std::setprecision(1) << join(vVerifyMs, [](double x) { return x; }) << ","
+            << bestIdx << "," << (bestIdx >= 0 ? (long)vpCandidateKFs[bestIdx]->mnId : -1L) << "," << bestGood << ","
+            << (bAccepted ? 1 : 0) << "," << mnRelocPendingCount << "," << (bConfirmed ? 1 : 0) << ","
+            << std::setprecision(4) << dDist << "," << dAng;
+        if(bestIdx >= 0)
+        {
+            cv::Mat Rwc = bestTcw.rowRange(0,3).colRange(0,3).t();
+            cv::Mat Ow = -Rwc*bestTcw.rowRange(0,3).col(3);
+            vector<float> qv = Converter::toQuaternion(Rwc);
+            mLearnedRelocLog << std::setprecision(6) << "," << Ow.at<float>(0) << "," << Ow.at<float>(1) << ","
+                << Ow.at<float>(2) << "," << qv[0] << "," << qv[1] << "," << qv[2] << "," << qv[3];
+        }
+        else
+            mLearnedRelocLog << ",,,,,,,";
+        mLearnedRelocLog << "\n";
+        mLearnedRelocLog.flush();
+    }
+
+    if(!bConfirmed)
+        return false;
+    mnRelocPendingCount = 0;
+    mnLastRelocFrameId = mCurrentFrame.mnId;
+    mbRelocalizedThisFrame = true;
+    cout << "Relocalized (learned, " << bestGood << " inliers, keyframe " << vpCandidateKFs[bestIdx]->mnId << ")" << endl;
+    return true;
+}
+
 void Tracking::SetRelocalizeOnly(const bool &flag)
 {
     mbRelocOnly = flag;
