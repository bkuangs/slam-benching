+// slam-benching patch (relocalization monitor), see Tracking.h. Called after tracking in localization
+// mode; returns whether the frame stays tracked.
+bool Tracking::RelocMonitor(bool bOK)
+{
+    typedef std::chrono::steady_clock clk;
+    const clk::time_point t0 = clk::now();
+    const double t = mCurrentFrame.mTimeStamp;
+    if(!bOK)
+    {
+        mdRelocMonitorVOStart = -1.0;
+        return false;
+    }
+    if(mbRelocalizedThisFrame || mdRelocMonitorLastVerified < 0)
+    {
+        mdRelocMonitorLastVerified = t;
+        mnRelocMonitorSinceCheck = 0;
+    }
+    if(!mbVO)
+        mdRelocMonitorVOStart = -1.0;
+    else if(mdRelocMonitorVOStart < 0)
+        mdRelocMonitorVOStart = t;
+
+    std::string trigger, decision;
+    const int trackedInl = mbVO ? 0 : mnMatchesInliers;
+    int localInl = 0;
+    bool bVerified = false;
+    float dDist = -1.f, dAng = -1.f;
+
+    // 1. Periodic re-verification of a map-tracked frame (VO-only frames already try to relocalize).
+    if(!mbVO && !mbRelocalizedThisFrame && ++mnRelocMonitorSinceCheck >= mnRelocMonitorPeriod)
+    {
+        trigger = "period";
+        mnRelocMonitorSinceCheck = 0;
+        const cv::Mat TcwT = mCurrentFrame.mTcw.clone();
+        const vector<MapPoint*> vpMPsT = mCurrentFrame.mvpMapPoints;
+        const vector<bool> vbOutT = mCurrentFrame.mvbOutlier;
+        const int nInlT = mnMatchesInliers;
+        mbRelocMonitorProbe = true;
+        bVerified = LearnedRelocalization();
+        mbRelocMonitorProbe = false;
+        if(bVerified)
+        {
+            mdRelocMonitorLastVerified = t;
+            SlambenchPoseDiff(TcwT, mCurrentFrame.mTcw, dDist, dAng);
+        }
+        if(bVerified && (dDist > mfRelocMonitorMaxDevM || dAng > mfRelocMonitorMaxDevDeg))
+        {
+            // Reset to the verified pose and track the local map from it, as after a relocalization.
+            mnLastRelocFrameId = mCurrentFrame.mnId;
+            bOK = TrackLocalMap();
+            localInl = mnMatchesInliers;
+            decision = bOK ? "reset" : "reset_lost";
+            if(bOK)
+            {
+                mbRelocalizedThisFrame = true;
+                mbRelocMonitorReset = true;
+                mRelocMonitorTrackedTcw = TcwT;
+            }
+        }
+        else
+        {
+            mCurrentFrame.SetPose(TcwT);
+            mCurrentFrame.mvpMapPoints = vpMPsT;
+            mCurrentFrame.mvbOutlier = vbOutT;
+            mnMatchesInliers = nInlT;
+            decision = bVerified ? "agree" : "unverified";
+        }
+    }
+
+    // 2. Optional budgets: VO-only for too long, or no verified pose for too long.
+    if(bOK && !mbRelocalizedThisFrame)
+    {
+        const char* lost = NULL;
+        if(mbVO && mfRelocMonitorMaxVOs > 0 && t - mdRelocMonitorVOStart > mfRelocMonitorMaxVOs)
+            lost = "vo_timeout";
+        else if(mfRelocMonitorMaxUnverifiedS > 0 && t - mdRelocMonitorLastVerified > mfRelocMonitorMaxUnverifiedS)
+            lost = "unverified_timeout";
+        if(lost)
+        {
+            trigger = trigger.empty() ? lost : trigger + "+" + lost;
+            decision = "lost";
+            bOK = false;
+        }
+    }
+    if(!bOK)
+        mdRelocMonitorVOStart = -1.0;
+
+    if(mRelocMonitorLog.is_open() && !trigger.empty())
+    {
+        mRelocMonitorLog << std::fixed << std::setprecision(9) << t << "," << mCurrentFrame.mnId << "," << trigger << ","
+            << trackedInl << "," << (bVerified ? (mbLearnedRelocLastPrior ? "prior" : "vpr") : "0") << ","
+            << (trigger.rfind("period", 0) == 0 ? mnLearnedRelocLastInliers : 0) << ","
+            << std::setprecision(4) << dDist << "," << dAng << "," << decision << "," << localInl << ","
+            << std::setprecision(3) << t - mdRelocMonitorLastVerified << ","
+            << std::setprecision(1) << std::chrono::duration<double, std::milli>(clk::now() - t0).count() << "\n";
+        mRelocMonitorLog.flush();
+    }
+    return bOK;
+}
